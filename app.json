{
  "expo": {
    "scheme": "acme",
    "name": "lala",
    "slug": "lala",
    "plugins": [
      "expo-router",
      [
        "react-native-vision-camera",
        {
          "cameraPermissionText": "我們需要使用您的相機來即時偵測您的運動骨骼姿勢，以防止運動受傷。"
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "15.1",
            "useFrameworks": "dynamic"
          }
        }
      ],
      [
        "@react-native-firebase/app",
        {}
      ],
      [
        "@react-native-firebase/auth",
        {}
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "f2ff4200-00a8-4962-96d4-e24a5f44873e"
      }
    },
    "runtimeVersion": "1.0.0",
    "updates": {
      "url": "https://u.expo.dev/f2ff4200-00a8-4962-96d4-e24a5f44873e"
    },
    "android": {
      "googleServicesFile": "google-services.json",
      "permissions": [
        "android.permission.CAMERA"
      ],
      "package": "com.rwei_app.lala"
    },
    "ios": {
      "googleServicesFile": "GoogleService-Info.plist",
      "infoPlist": {
        "NSCameraUsageDescription": "我們需要使用您的相機來即時偵測您的運動骨骼姿勢，以防止運動受傷。"
      },
      "bundleIdentifier": "com.rwei-app.lala"
    }
  }
}
